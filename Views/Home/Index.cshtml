@using APMS.Frontend.Models
@model APMS.Frontend.Models.DashboardViewModel

<!-- Header -->
<div class="bg-gradient-to-r from-red-700 via-red-600 to-orange-600 border-b-4 border-red-800 shadow-lg">
    <div class="max-w-7xl mx-auto px-6 py-6">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div>
                    <img src="~/images/iocl-logo.png.png" alt="Indian Oil Corporation Limited logo, white emblem on transparent background" class="w-12 h-12 object-contain mb-2" />
                    <h1 class="text-3xl font-bold text-white">IOCL APMS</h1>
                    <p class="text-red-100 text-sm">AI-Powered Maintenance System</p>
                </div>
            </div>
            <div class="text-right">
                <div class="text-white font-mono text-lg font-bold" id="currentDateTime">Loading...</div>
                <div class="text-red-100 text-xs mt-1">Real-Time Monitoring Active</div>
            </div>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="max-w-7xl mx-auto px-6 py-8">
    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <!-- Systems Online -->
        <div class="bg-slate-700 border border-slate-600 rounded-lg p-6 shadow-lg hover:shadow-xl transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-slate-400 text-sm font-semibold">SYSTEMS ONLINE</p>
                    <p class="text-4xl font-bold text-white mt-2">@Model.SystemsOnline/6</p>
                </div>
                <svg class="w-12 h-12 text-green-500 opacity-70" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
            </div>
        </div>

        <!-- Alerts Pending -->
        <div class="bg-slate-700 border border-slate-600 rounded-lg p-6 shadow-lg hover:shadow-xl transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-slate-400 text-sm font-semibold">ALERTS PENDING</p>
                    <p class="text-4xl font-bold text-yellow-400 mt-2">@Model.AlertsPending</p>
                </div>
                <svg class="w-12 h-12 text-yellow-500 opacity-70" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"></path>
                    <path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05A2.5 2.5 0 0115.95 16H17a1 1 0 001-1v-5a1 1 0 00-.293-.707l-2-2A1 1 0 0015 7h-1z"></path>
                </svg>
            </div>
        </div>

        <!-- Avg Efficiency -->
        <div class="bg-slate-700 border border-slate-600 rounded-lg p-6 shadow-lg hover:shadow-xl transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-slate-400 text-sm font-semibold">AVG EFFICIENCY</p>
                    <p class="text-4xl font-bold text-blue-400 mt-2">@Model.AvgEfficiency.ToString("F1")%</p>
                </div>
                <svg class="w-12 h-12 text-blue-500 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                </svg>
            </div>
        </div>

        <!-- Critical Issues -->
        <div class="bg-slate-700 border border-slate-600 rounded-lg p-6 shadow-lg hover:shadow-xl transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-slate-400 text-sm font-semibold">CRITICAL ISSUES</p>
                    <p class="text-4xl font-bold text-red-400 mt-2">@Model.CriticalIssues</p>
                </div>
                <svg class="w-12 h-12 text-red-500 opacity-70" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                </svg>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- System Status Table -->
        <div class="lg:col-span-2">
            <div class="bg-slate-700 border border-slate-600 rounded-lg shadow-lg overflow-hidden">
                <div class="bg-gradient-to-r from-red-700 to-orange-600 px-6 py-4">
                    <h2 class="text-xl font-bold text-white flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
                        </svg>
                        System Status & Health
                    </h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="border-b border-slate-600 bg-slate-800">
                                <th class="px-6 py-3 text-left text-xs font-bold text-slate-300 uppercase">Machine</th>
                                <th class="px-6 py-3 text-left text-xs font-bold text-slate-300 uppercase">Status</th>
                                <th class="px-6 py-3 text-left text-xs font-bold text-slate-300 uppercase">Efficiency</th>
                                <th class="px-6 py-3 text-left text-xs font-bold text-slate-300 uppercase">Risk Level</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var machine in Model.Machines)
                            {
                                <tr class="border-b border-slate-600 hover:bg-slate-600 transition">
                                    <td class="px-6 py-4 text-sm text-white font-medium">@machine.Name</td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-2">
                                            @if (machine.Status == "healthy")
                                            {
                                                <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                                </svg>
                                            }
                                            else if (machine.Status == "warning")
                                            {
                                                <svg class="w-5 h-5 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg class="w-5 h-5 text-red-600" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M13.477 14.89A6 6 0 105.11 2.36a6.002 6.002 0 008.367 12.529l.001.001A6.002 6.002 0 0013.477 14.89zM9 11a2 2 0 104 0 2 2 0 00-4 0z" clip-rule="evenodd"></path>
                                                </svg>
                                            }
                                            <span class="text-sm text-slate-300">@machine.Status</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-2">
                                            <div class="w-24 bg-slate-600 rounded-full h-2">
                                                <div class="@MachineHelper.GetBarColor(machine.Efficiency) h-2 rounded-full" style="width: @(machine.Efficiency)%"></div>
                                            </div>
                                            <span class="text-sm font-semibold text-slate-300">@machine.Efficiency%</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-sm font-bold @MachineHelper.GetRiskColor(machine.RiskLevel)">
                                        @machine.RiskLevel?.ToUpper()
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
<!-- Critical Alerts --->
<div>
    <div class="bg-slate-700 border border-slate-600 rounded-lg shadow-lg overflow-hidden h-full flex flex-col">
        <div class="bg-gradient-to-r from-red-700 to-orange-600 px-6 py-4">
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
                ⚙️ Critical Alerts
            </h2>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="border-b border-slate-600 bg-slate-800">
                        <th class="px-6 py-3 text-left text-xs font-bold text-slate-300 uppercase">Alert Type</th>
                        <th class="px-6 py-3 text-left text-xs font-bold text-slate-300 uppercase">Message</th>
                        <th class="px-6 py-3 text-left text-xs font-bold text-slate-300 uppercase">Time</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var alert in Model.Alerts)
                    {
                        <tr class="border-b border-slate-600 hover:bg-slate-600 transition">
                            <td class="px-6 py-4 text-sm text-white font-medium">
                                <span class="px-3 py-1 rounded-full text-xs font-bold @(alert.Severity == "critical" ? "bg-red-900 text-red-200" : alert.Severity == "warning" ? "bg-yellow-900 text-yellow-200" : "bg-blue-900 text-blue-200")">
                                    @(alert.Severity?.ToUpper() ?? "UNKNOWN")
                                </span>
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-200 font-semibold">@alert.Message</td>
                            <td class="px-6 py-4 text-sm text-slate-300">@alert.Time</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

    <!-- Maintenance Schedule -->
    <div class="mt-8">
        <div class="bg-slate-700 border border-slate-600 rounded-lg shadow-lg overflow-hidden">
            <div class="bg-gradient-to-r from-red-700 to-orange-600 px-6 py-4">
                <h2 class="text-xl font-bold text-white flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    Upcoming Maintenance Schedule
                </h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="border-b border-slate-600 bg-slate-800">
                            <th class="px-6 py-3 text-left text-xs font-bold text-slate-300 uppercase">Machine</th>
                            <th class="px-6 py-3 text-left text-xs font-bold text-slate-300 uppercase">Next Maintenance</th>
                            <th class="px-6 py-3 text-left text-xs font-bold text-slate-300 uppercase">Time Remaining</th>
                            <th class="px-6 py-3 text-left text-xs font-bold text-slate-300 uppercase">Priority</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var schedule in Model.MaintenanceSchedules)
                        {
                            <tr class="border-b border-slate-600 hover:bg-slate-600 transition">
                                <td class="px-6 py-4 text-sm text-white font-medium">@schedule.Machine</td>
                                <td class="px-6 py-4 text-sm text-slate-300">@schedule.NextMaintenance</td>
                                <td class="px-6 py-4 text-sm text-slate-300">@schedule.HoursRemaining h</td>
                                <td class="px-6 py-4">
                                    <span class="px-3 py-1 rounded-full text-xs font-bold @MachineHelper.GetPriorityClass(schedule.Priority)">
                                        @schedule.Priority?.ToUpper()
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Footer -->
<div class="mt-12 border-t border-slate-700 bg-slate-800 bg-opacity-50">
    <div class="max-w-7xl mx-auto px-6 py-4 text-center text-slate-400 text-sm">
        <p>© 2026 Indian Oil Corporation Limited | AI-Powered Maintenance System |</p>
        <p class="mt-2 text-xs text-slate-500">Made by Team XENIX</p>
    </div>
</div>